GEMINI_API_KEY=paste-your-key-here
# Comma-separated fallback chains: first available model wins, next is tried on 503/429
PRIMARY_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite
CROSSCHECK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite
EMBED_MODEL=gemini-embedding-2
JUDGE_RUNS=3
